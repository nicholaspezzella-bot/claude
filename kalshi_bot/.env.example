# Kalshi API credentials
# Get your API key from https://kalshi.com/account/api
KALSHI_API_KEY_ID=your-uuid-key-id-here
KALSHI_PRIVATE_KEY_PATH=/path/to/your/private_key.pem

# Kalshi environment: "production" or "demo"
KALSHI_ENV=production

# The Odds API key (for cross-book price comparison)
# Get from https://the-odds-api.com
ODDS_API_KEY=your-odds-api-key-here

# Bankroll management
BANKROLL=10000.00
KELLY_FRACTION=0.25
MAX_POSITION_PCT=0.03
MIN_EDGE_THRESHOLD=0.05

# Strategy settings
MIN_PROB_THRESHOLD=0.05
MAX_PROB_THRESHOLD=0.60
LOOP_INTERVAL_SECONDS=60
DRY_RUN=true
